# Application
APP_NAME=GeneGlass API
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api
DATABASE_PATH=data/geneglass.db

# Authentication: generate a different secret for every deployed environment.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Explicit browser origins, separated by commas.
# The included static frontend is documented to run locally on port 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
